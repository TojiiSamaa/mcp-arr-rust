# Exemple : /etc/systemd/system/arrmcp-pull-deploy.service (à installer par Toji sur l'hôte de prod).
[Unit]
Description=arrmcp : tirer :prod, relancer, contrôler la santé, rollback si échec
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Variables de l'hôte (COMPOSE_FILE, HEALTH_URL, ARR_MCP_TOKEN si le contrôle MCP est voulu...) ; fichier non versionné.
EnvironmentFile=-/etc/arrmcp/pull-deploy.env
ExecStart=/opt/arrmcp/deploy/pull-deploy.sh
