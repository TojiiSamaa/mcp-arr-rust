# Exemple : /etc/systemd/system/arrmcp-pull-deploy.timer (systemctl enable --now arrmcp-pull-deploy.timer).
# Équivalent cron : */5 * * * * /opt/arrmcp/deploy/pull-deploy.sh
[Unit]
Description=arrmcp : vérifier une nouvelle image :prod toutes les 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30
Unit=arrmcp-pull-deploy.service

[Install]
WantedBy=timers.target
